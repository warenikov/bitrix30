{
    "name": "bitrix30/bitrix30",
    "description": "Modern PHP framework with Bitrix concepts: components, inheritable sites, solutions, content model. Not affiliated with 1C-Bitrix.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laminas/laminas-httphandlerrunner": "^2.14",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "php-di/php-di": "^7.1",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0",
        "symfony/routing": "^7.4",
        "twig/twig": "^3.30"
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "cs": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer check --diff"
    },
    "autoload": {
        "psr-4": {
            "Bitrix30\\": "src/",
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bitrix30\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^12.5"
    }
}
